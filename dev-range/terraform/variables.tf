variable "deployment_id" {
  type        = string
  description = "Immutable random identifier generated by range.py init; do not reuse another deployment's ID."
  validation {
    condition     = can(regex("^[a-f0-9]{12}$", var.deployment_id))
    error_message = "deployment_id must be twelve lowercase hexadecimal characters."
  }
}

variable "region" {
  type    = string
  default = "sfo3"
  validation {
    condition     = var.region == "sfo3"
    error_message = "This prototype is verified only in sfo3. Review image availability before adding regions."
  }
}

variable "admin_cidrs" {
  type        = list(string)
  description = "Specific operator public IPv4 /32 addresses allowed to SSH into new Droplets."
  validation {
    condition     = length(var.admin_cidrs) > 0 && alltrue([for cidr in var.admin_cidrs : can(cidrhost(cidr, 0)) && endswith(cidr, "/32")])
    error_message = "At least one explicit IPv4 /32 is required; broad public SSH rules are forbidden."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "Public half of a deployment-only SSH key. Private keys never enter Terraform state."
  validation {
    condition     = startswith(var.ssh_public_key, "ssh-ed25519 ")
    error_message = "Use a deployment-only ed25519 public key."
  }
}

variable "kali_image_id" {
  type        = number
  default     = 253485598
  description = "Read-only use of the existing CLEAN Kali custom image; never a populated pilot snapshot."
}

variable "underlay_cidr" {
  type    = string
  default = "10.160.0.0/24"
}

variable "bootstrap_egress" {
  type        = bool
  default     = true
  description = "Permit DNS and HTTP(S) package downloads during configuration. Set false before opening playtest access."
}

variable "relay_public_ip" {
  type        = string
  default     = "165.232.145.224"
  description = "Read-only relay address. Prototype RDP/TLS accepts ONLY this /32; no peering or relay route changes."
}

